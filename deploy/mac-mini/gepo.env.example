# Copy to ~/.gepo_env on the Mac mini and edit.
# Keep this file out of git with real secrets/hosts.

# Mya server used by live/upload_to_mya.sh and health alert upload.
export MYA_SSH_HOST="ubuntu@REPLACE_ME"
export MYA_REMOTE_BASE="/opt/vito/gepo-backtest/live"

# Optional if the default SSH key is not the right one.
# export MYA_SSH_KEY="$HOME/.ssh/id_ed25519"

# IB Gateway API port.
# Live Gateway default: 4001
# Paper Gateway default: 4002
export IB_PORT=4001

# Optional watchdog override for live/pull_now_parallel.sh SPY step.
# export SPY_FETCH_TIMEOUT=90
